+function clock() {
+    let time = 0;
+    let id = 0;
+    const timers = new Map();
+    return {
+        now: () => time,
+        setTimer(fn, delay) { timers.set(++id, { fn, at: time + delay }); return id; },
+        clearTimer(id) { timers.delete(id); },
+        tick(ms) {
+            time += ms;
+            for (const [key, timer] of [...timers]) {
+                if (timer.at <= time) { timers.delete(key); timer.fn(); }
+            }
+        },
+        count: () => timers.size
+    };
