# Supplier Programme delivery. Mirror these locally for testing and configure
# the same values in Vercel Project Settings. Never commit real secrets.
ORIGIN_MAKE_WEBHOOK_URL=
ORIGIN_MAKE_WEBHOOK_API_KEY=

# Local automation administration only. Never add MAKE_API_TOKEN to Vercel.
MAKE_API_TOKEN=
MAKE_ZONE=eu1

# Existing demo, newsletter and careers delivery; also optional internal alert
# for supplier failures. Supplier success still requires a confirmed Sheet write.
BREVO_API_KEY=
ORIGIN_NOTIFY_EMAIL=sreenath@kananlabs.in
ORIGIN_SENDER_EMAIL=raya@kananlabs.in

# Careers: required before production. Create/verify the applications list in
# Brevo and choose the inbox receiving complete applications and attached CVs.
BREVO_CAREERS_LIST_ID=
CAREERS_NOTIFY_EMAIL=
# Optional override; the default careers@kananlabs.in must be a verified sender.
CAREERS_SENDER_EMAIL=
# Optional candidate acknowledgement template; not the application record.
BREVO_CAREERS_TEMPLATE_ID=

# Existing newsletter/early-access lists and TradeWatch acknowledgement.
# Leave blank to retain the handler's existing defaults; verify those in Brevo.
BREVO_LIST_ID=
BREVO_EARLY_ACCESS_LIST_ID=
BREVO_NEWSLETTER_TEMPLATE_ID=
BREVO_DEMO_TEMPLATE_ID=
