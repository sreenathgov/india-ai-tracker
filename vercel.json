{
  "version": 2,
  "buildCommand": "npm test && npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/supplier-programme.js": {"includeFiles": "data/supplier-programme/localization/manifest.json", "maxDuration": 30},
    "api/apply.js": {"includeFiles": "data/careers.json", "maxDuration": 30},
    "api/consult.js": {"maxDuration": 30},
    "api/subscribe.js": {"maxDuration": 30},
    "api/early-access.js": {"maxDuration": 30}
  },
  "redirects": [
    {"source":"/", "has":[{"type":"host","value":"apply.kananlabs.in"}], "destination":"/supplier-programme.html", "permanent":false},
    {"source":"/supplier-programme.html", "has":[{"type":"host","value":"kananlabs.in"}], "destination":"https://apply.kananlabs.in/", "permanent":true},
    {"source":"/supplier-programme.html", "has":[{"type":"host","value":"www.kananlabs.in"}], "destination":"https://apply.kananlabs.in/", "permanent":true},
    {"source":"/project-origin.html", "destination":"/supplier-programme.html", "permanent":true},
    {"source":"/project-origin", "destination":"/supplier-programme.html", "permanent":true},
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/all-india/index.html", "destination": "/all-india/", "permanent": true },

    { "source": "/states/nct-of-delhi", "destination": "/states/delhi/", "permanent": true },
    { "source": "/states/nct-of-delhi/", "destination": "/states/delhi/", "permanent": true },
    { "source": "/states/nct-of-delhi/index.html", "destination": "/states/delhi/", "permanent": true },
    { "source": "/states/telengana", "destination": "/states/telangana/", "permanent": true },
    { "source": "/states/telengana/", "destination": "/states/telangana/", "permanent": true },
    { "source": "/states/telengana/index.html", "destination": "/states/telangana/", "permanent": true },
    { "source": "/states/orissa", "destination": "/states/odisha/", "permanent": true },
    { "source": "/states/orissa/", "destination": "/states/odisha/", "permanent": true },
    { "source": "/states/orissa/index.html", "destination": "/states/odisha/", "permanent": true },
    { "source": "/states/chattisgarh", "destination": "/states/chhattisgarh/", "permanent": true },
    { "source": "/states/chattisgarh/", "destination": "/states/chhattisgarh/", "permanent": true },
    { "source": "/states/chattisgarh/index.html", "destination": "/states/chhattisgarh/", "permanent": true },
    { "source": "/states/uttaranchal", "destination": "/states/uttarakhand/", "permanent": true },
    { "source": "/states/uttaranchal/", "destination": "/states/uttarakhand/", "permanent": true },
    { "source": "/states/uttaranchal/index.html", "destination": "/states/uttarakhand/", "permanent": true },
    { "source": "/states/pondicherry", "destination": "/states/puducherry/", "permanent": true },
    { "source": "/states/pondicherry/", "destination": "/states/puducherry/", "permanent": true },
    { "source": "/states/pondicherry/index.html", "destination": "/states/puducherry/", "permanent": true },
    { "source": "/states/andaman-and-nicobar", "destination": "/states/andaman-and-nicobar-islands/", "permanent": true },
    { "source": "/states/andaman-and-nicobar/", "destination": "/states/andaman-and-nicobar-islands/", "permanent": true },
    { "source": "/states/andaman-and-nicobar/index.html", "destination": "/states/andaman-and-nicobar-islands/", "permanent": true },

    {"source": "/careers/cofounder-cto", "destination": "/careers.html", "permanent": true},
    {"source": "/careers/cofounder-cto/", "destination": "/careers.html", "permanent": true},
    {"source": "/careers/cofounder-cto/index.html", "destination": "/careers.html", "permanent": true},
    {"source": "/careers/founding-cto", "destination": "/careers.html", "permanent": true},
    {"source": "/careers/founding-cto/", "destination": "/careers.html", "permanent": true},
    {"source": "/careers/founding-cto/index.html", "destination": "/careers.html", "permanent": true},
    {"source": "/careers/founding-product-engineer", "destination": "/careers/founding-ai-engineer-full-stack/", "permanent": true},
    {"source": "/careers/founding-product-engineer/", "destination": "/careers/founding-ai-engineer-full-stack/", "permanent": true},
    {"source": "/careers/founding-product-engineer/index.html", "destination": "/careers/founding-ai-engineer-full-stack/", "permanent": true},
    {"source": "/careers/founding-engineer-full-stack", "destination": "/careers/founding-ai-engineer-full-stack/", "permanent": true},
    {"source": "/careers/founding-engineer-full-stack/", "destination": "/careers/founding-ai-engineer-full-stack/", "permanent": true},
    {"source": "/careers/founding-engineer-full-stack/index.html", "destination": "/careers/founding-ai-engineer-full-stack/", "permanent": true},
    {"source": "/careers/trade-practice-lead", "destination": "/careers.html", "permanent": true},
    {"source": "/careers/trade-practice-lead/", "destination": "/careers.html", "permanent": true},
    {"source": "/careers/trade-practice-lead/index.html", "destination": "/careers.html", "permanent": true},
    {"source": "/careers/head-of-customs-trade-compliance", "destination": "/careers.html", "permanent": true},
    {"source": "/careers/head-of-customs-trade-compliance/", "destination": "/careers.html", "permanent": true},
    {"source": "/careers/head-of-customs-trade-compliance/index.html", "destination": "/careers.html", "permanent": true},
    {"source": "/careers/regulatory-knowledge-engineer", "destination": "/careers.html", "permanent": true},
    {"source": "/careers/regulatory-knowledge-engineer/", "destination": "/careers.html", "permanent": true},
    {"source": "/careers/regulatory-knowledge-engineer/index.html", "destination": "/careers.html", "permanent": true},
    {"source": "/careers/trade-compliance-analyst", "destination": "/careers.html", "permanent": true},
    {"source": "/careers/trade-compliance-analyst/", "destination": "/careers.html", "permanent": true},
    {"source": "/careers/trade-compliance-analyst/index.html", "destination": "/careers.html", "permanent": true},
    {"source": "/careers/regulatory-systems-engineer", "destination": "/careers.html", "permanent": true},
    {"source": "/careers/regulatory-systems-engineer/", "destination": "/careers.html", "permanent": true},
    {"source": "/careers/regulatory-systems-engineer/index.html", "destination": "/careers.html", "permanent": true},
    {"source": "/careers/senior-data-engineer-regulatory-data", "destination": "/careers.html", "permanent": true},
    {"source": "/careers/senior-data-engineer-regulatory-data/", "destination": "/careers.html", "permanent": true},
    {"source": "/careers/senior-data-engineer-regulatory-data/index.html", "destination": "/careers.html", "permanent": true},

    { "source": "/states/:slug/index.html", "destination": "/states/:slug/", "permanent": true },
    { "source": "/publications/:slug/index.html", "destination": "/publications/:slug/", "permanent": true },
    { "source": "/careers/:slug/index.html", "destination": "/careers/:slug/", "permanent": true },

    { "source": "/careers", "destination": "/careers.html", "permanent": true },
    { "source": "/careers/", "destination": "/careers.html", "permanent": true },

    { "source": "/publications.html", "destination": "/resources.html", "permanent": true },
    { "source": "/publications", "destination": "/resources.html", "permanent": true },
    { "source": "/publications/", "destination": "/resources.html", "permanent": true }
  ],
  "rewrites": [
    {"source":"/robots.txt", "has":[{"type":"host","value":"apply.kananlabs.in"}], "destination":"/application-robots.txt"},
    {"source":"/sitemap.xml", "has":[{"type":"host","value":"apply.kananlabs.in"}], "destination":"/application-sitemap.xml"}
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), microphone=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://www.google-analytics.com https://www.googletagmanager.com https://*.arcgisonline.com; media-src 'self'; connect-src 'self' https://www.google-analytics.com https://www.googletagmanager.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/api/subscribe",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/api/early-access",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/api/consult",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/api/apply",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/api/supplier-programme",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/api/((?!subscribe|consult|early-access|apply|supplier-programme).*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/added-assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
